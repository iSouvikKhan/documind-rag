# Copy to backend/.env and adjust. Values shown are the defaults unless marked as placeholders.

# --- Database (PostgreSQL 14+ with the pgvector extension) ---
DATABASE_URL=postgresql://documind:documind@localhost:5432/documind
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_CONNECT_TIMEOUT=5

# --- Model providers: ollama (default, local, no key) | openai | gemini ---
LLM_PROVIDER=ollama
# Leave empty for the provider default: llama3.2 / gpt-4o-mini / gemini-2.5-flash
LLM_MODEL=
LLM_TEMPERATURE=0.1

EMBEDDING_PROVIDER=ollama
# Leave empty for the provider default: nomic-embed-text / text-embedding-3-small / models/gemini-embedding-001
EMBEDDING_MODEL=
# Must equal the embedding model's output size (nomic-embed-text = 768).
# OpenAI text-embedding-3-* and Gemini embeddings are requested at this size.
# Changing it after ingesting documents requires dropping the tables.
EMBEDDING_DIM=768

OLLAMA_BASE_URL=http://localhost:11434

# Only needed when a provider above is set to openai / gemini
OPENAI_API_KEY=your-openai-api-key
# Optional: OpenAI-compatible endpoint
OPENAI_BASE_URL=
GOOGLE_API_KEY=your-google-api-key

# --- Ingestion ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=20

# --- Retrieval ---
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
RRF_K=60
# flashrank (cross-encoder, downloads a ~22 MB model on first use) | none
RERANKER=flashrank
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANKER_CACHE_DIR=.cache/flashrank
FINAL_TOP_K=5
# grounded (strict, cite every claim) | basic
PROMPT_STYLE=grounded

# --- API ---
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
